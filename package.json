{
  "name": "liuren-pan-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "api:dev": "node server.mjs",
    "build": "tsc -b && vite build && node scripts/postbuild-seo.mjs",
    "lint": "eslint .",
    "pareto:failures": "node scripts/failure-pareto-report.mjs",
    "preview": "vite preview",
    "test": "vitest",
    "test:run": "vitest run",
    "cap:sync": "npm run build && cap sync ios",
    "cap:open": "cap open ios",
    "ios": "npm run build && cap sync ios && cap open ios",
    "api:shichusuimei": "node --env-file-if-exists=.env --import tsx server/shichusuimei/local.ts"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.263",
    "@anthropic-ai/sdk": "0.124.0",
    "@capacitor/app": "^8.1.1",
    "@capacitor/cli": "^8.5.0",
    "@capacitor/core": "^8.5.0",
    "@capacitor/ios": "^8.5.0",
    "@capacitor/status-bar": "^8.0.3",
    "lunar-typescript": "^1.8.6",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "tsx": "4.23.13",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@eslint/js": "^9.39.4",
    "@playwright/test": "^1.59.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.12.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "jsdom": "^29.0.2",
    "serve": "^14.2.6",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.58.0",
    "vite": "^8.0.4",
    "vitest": "^4.1.3",
    "wrangler": "^4.90.0"
  },
  "allowScripts": {
    "esbuild@0.27.3": true,
    "sharp@0.34.5": true,
    "workerd@1.20260507.1": true,
    "sharp@0.32.6": true
  }
}
