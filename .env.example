VITE_SITE_URL=https://your-domain.example
VITE_AI_FEEDBACK_MODE=disabled
VITE_AI_CHECKOUT_URL=

# Native (iOS/Capacitor) build only. The app origin is capacitor://localhost,
# so AI/checkout calls must use an ABSOLUTE API URL (relative paths won't
# resolve). Leave empty to ship the app fully offline (core divination works;
# AI feedback stays disabled). When enabling AI, also add capacitor://localhost
# to the API's ALLOWED_ORIGINS.
VITE_API_BASE_URL=

AI_FEEDBACK_MODE=disabled
AI_FEEDBACK_CHECKOUT_URL=
AI_FEEDBACK_MAX_TOKENS=1200
ANTHROPIC_MODEL=claude-sonnet-4-20250514
ANTHROPIC_API_KEY=

# Shichusuimei server only (Node 22+). Never prefix access codes/API keys with VITE_.
SHICHUSUIMEI_MODEL=claude-sonnet-4-6
# 用神判定回路（POST /api/shichusuimei/yongshen, npm run shichusuimei:circuit）。未指定は claude-opus-5。
SHICHUSUIMEI_CIRCUIT_MODEL=
# 回路の効力。既定 high。low/medium にすると速く安くなる（判断の粗さと引き換え）。
SHICHUSUIMEI_CIRCUIT_EFFORT=
# 古典和訳（*.md）のローカルフォルダ。本文はリポジトリに入れない。未指定なら同梱の抜粋139件を使う。
SHICHUSUIMEI_CLASSICS_DIR=
SHICHUSUIMEI_PORT=8788
# Optional: use an explicitly selected authenticated Claude CLI.
# CLAUDE_EXECUTABLE=/path/to/claude
# Public Worker secret; local loopback API does not require it.
SHICHUSUIMEI_ACCESS_TOKEN=
